# ============================================================
# AegisX Environment Variables — copy to .env and fill values
# ============================================================

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegisx
POSTGRES_USER=aegisx_user
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- LLM ---
# Local Ollama endpoint
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# HuggingFace (for fine-tuning / remote inference)
HUGGINGFACE_TOKEN=CHANGE_ME

# --- Threat Intelligence ---
VIRUSTOTAL_API_KEY=CHANGE_ME
OTX_API_KEY=CHANGE_ME
ABUSEIPDB_API_KEY=CHANGE_ME
SHODAN_API_KEY=CHANGE_ME
CENSYS_API_ID=CHANGE_ME
CENSYS_API_SECRET=CHANGE_ME

# --- Backend ---
SECRET_KEY=CHANGE_ME_RANDOM_32_CHARS
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Endpoint Agent Integration ---
# Admin key that protects enrollment-token minting and agent revocation.
# Generate a strong random value, e.g.  python -c "import secrets;print(secrets.token_urlsafe(32))"
AEGISX_ADMIN_API_KEY=CHANGE_ME_ADMIN_KEY
# Presence thresholds (seconds) — an endpoint is Warning then Offline as its
# last heartbeat ages past these. Tune to your heartbeat interval.
ENDPOINT_WARNING_TIMEOUT_SECONDS=90
ENDPOINT_OFFLINE_TIMEOUT_SECONDS=180
# Default enrollment-token lifetime (seconds).
ENROLLMENT_TOKEN_TTL_SECONDS=86400
# Max events accepted per agent /events batch.
ENDPOINT_EVENT_BATCH_MAX=500

# --- Neo4j (optional — Phase 6+) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME
